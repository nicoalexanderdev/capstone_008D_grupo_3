{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-metrosence.onrender.com/api/v1",
        "EXPO_PUBLIC_TFLITE_MIDAS_URL": "https://api-metrosence.onrender.com/models/Midas-V2.tflite",
        "EXPO_PUBLIC_TFLITE_YOLO_URL": "https://storage.googleapis.com/metrosence_bucket/best_float32.tflite"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
